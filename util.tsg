// Shared helpers for the Java grammar.
// Mirrors the functions defined at the bottom of grammar.js.

macro sep1(rule: rule_t, separator: rule_t) rule_t {
    seq(rule, repeat(seq(separator, rule)))
}
macro commaSep1(rule: rule_t) rule_t { seq(rule, repeat(seq(",", rule))) }
macro commaSep(rule: rule_t) rule_t { optional(commaSep1(rule)) }
